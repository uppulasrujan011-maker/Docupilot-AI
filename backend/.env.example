# Google Gemini API Key (Recommended free tier from Google AI Studio - https://aistudio.google.com/)
GEMINI_API_KEY=

# Google Gemini Model (defaults to gemini-3.8-flash)
GEMINI_MODEL=gemini-3.8-flash

# Explicit AI provider (gemini, openai, or demo_mock)
LLM_PROVIDER=gemini

# Frontend origin for CORS policy (comma-separated list for multiple origins)
FRONTEND_ORIGIN=https://docupilot-ai-three.vercel.app,https://docupilot-ai-git-main-fursat1.vercel.app,http://localhost:5173

# SQLite database file path (attach persistent disk on Render/cloud hosting)
DATABASE_PATH=./docupilot.db
